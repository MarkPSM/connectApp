  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Calor extremo ocorre quando o ambiente est\xE1 muito quente e \xFAmido,
    aumentando o risco de superaquecimento e prejudicando a instala\xE7\xE3o dos
    cabos de fibra \xF3ptica. O excesso de calor pode afetar equipamentos, reduzir
    a durabilidade dos materiais e dificultar o trabalho da equipe.\n\nExemplos comuns:\n\nAmbientes
    sem ventila\xE7\xE3o.\n\nM\xE1quinas que liberam calor.\n\n\xC1reas expostas
    ao sol."
  m_isRightToLeft: 0
