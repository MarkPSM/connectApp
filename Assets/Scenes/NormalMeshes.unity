      m_Calls: []
  m_text: "Risco ambiental ocorre quando o local est\xE1 exposto a condi\xE7\xF5es
    naturais que podem prejudicar a instala\xE7\xE3o, como ventos fortes, tempestades
    ou mudan\xE7as clim\xE1ticas bruscas. Esses fatores podem danificar equipamentos
    e colocar em risco a equipe durante o trabalho.\n\nExemplos comuns:\n\n\xC1reas
    externas sem cobertura.\n\nLocais com ventos intensos.\n\nRegi\xF5es com chuvas
    fortes ou tempestades."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: d5cd24d9886a6324580ff12fe4cfc338, type: 2}
