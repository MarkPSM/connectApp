  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Risco qu\xEDmico ocorre quando o ambiente possui gases, vapores ou produtos
    qu\xEDmicos que podem ser nocivos \xE0 sa\xFAde do t\xE9cnico e tamb\xE9m prejudicar
    os cabos ou equipamentos utilizados na instala\xE7\xE3o.\n\nExemplos comuns:\n\n\xC1reas
    com forte cheiro de solventes ou tinta.\n\nAmbientes com produtos de limpeza
    concentrados.\n\nLocais pr\xF3ximos a armazenamento de qu\xEDmicos."
  m_isRightToLeft: 0
